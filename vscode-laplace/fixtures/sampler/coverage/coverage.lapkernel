//@laplace
//@brief Coverage fixture: every token class of the .lapkernel grammar
//@param eps Step size
//@param n_leap Leapfrog steps
//@note other doc tags are ignored by the parser: a plain comment
/* A block comment,
   over two lines. */
kernel coverage {
  tuning {
    real<lower=0> eps = 0.1 @adapt(step_size, target_accept = 0.65);
    vector<lower=0>[dim] m = rep_vector(1, dim) @adapt(metric);
    int<lower=1, upper=100> n_leap = 10;
  }
  state {
    real last_lp;
    matrix[2, 2] scratch;
    tuple(real, int) pair;
  }
  init {
    last_lp = 0;
  }
  functions {
    real half(real x) {
      return x / 2;
    }
  }
  step {
    vector[dim] p = sqrt(metric) .* std_normal_rng(dim);
    (vector[dim] q_new, vector[dim] p_new, real lp_new, vector[dim] g_new) = leapfrog(q, p, eps, n_leap, m);
    real h = lp_new - lp + half(dot_product(p ./ m, p) - dot_product(p_new ./ m, p_new));
    int k = 0;
    while (k < 3 && !(h > 1e3)) {
      k += 1;
    }
    if (k % 2 == 0 || h <= -1.5e-2) {
      h = h + normal_lpdf(1.0 | 0, 1) - std_normal_lpdf(0.5) + 0 * uniform_rng(0, 1) * normal_rng(0, 1);
    } else {
      h -= exp(log(sqrt(square(2.)))) + .5 - log_density(q_new) + sum(grad - g_new) ^ 2;
    }
    pair = (h, k);
    real first = pair.1;
    for (i in 1:dim) {
      first += 0 * q_new[i];
    }
    last_lp = lp_new;
    propose(q_new, first);
  }
}
